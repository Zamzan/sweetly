# =================================================================
# Sweetly — Environment variables
# Copy this file to .env.local for local dev.
# In Vercel: Project Settings -> Environment Variables.
# NEVER commit .env.local or any real values to Git.
# =================================================================

# --- Supabase (public, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# --- Supabase (SERVER ONLY — never prefix with NEXT_PUBLIC_) ---
# Used only in server actions / route handlers / webhooks that need
# to bypass RLS deliberately (e.g. writing an order on behalf of an
# anonymous customer after validating it, or subscription webhooks).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Base URL of the deployed app, used for absolute links (OG tags, etc).
# Do NOT hardcode this in source — read it from env everywhere.
NEXT_PUBLIC_SITE_URL=https://sweetly.vercel.app

# --- Admin session signing (REQUIRED for /admin to work at all now) ---
# A dedicated secret for signing the admin 2FA elevated-session cookie.
# Generate one with: openssl rand -hex 32
# Keep this separate from SUPABASE_SERVICE_ROLE_KEY on purpose — if one
# secret ever leaks, you don't want it to compromise both systems at once.
ADMIN_SESSION_SECRET=

# --- Rate limiting (Upstash Redis — free tier works for MVP) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Payment provider (Razorpay - Deprecated for customer subscription MVP) ---
# From Razorpay Dashboard -> Settings -> API Keys.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Sweetly Manual Subscription UPI Configuration ---
# Configurable UPI VPA where shops transfer ₹199/month for Sweetly Pro
SWEETLY_PAYMENT_UPI=zamzanjr10@okaxis

# --- Admin Notifications (Resend Email & Webhooks) ---
# Create a free API key at https://resend.com (free 3,000 emails/month)
RESEND_API_KEY=
# Administrator email address that receives instant payment alerts
ADMIN_NOTIFICATION_EMAIL=zamzanjr10@gmail.com
# Verified from address or default Resend test address (onboarding@resend.dev)
RESEND_FROM_EMAIL=Sweetly Alerts <onboarding@resend.dev>
# Optional Discord / Telegram / Slack / n8n webhook URL for push notifications
ADMIN_NOTIFICATION_WEBHOOK=


